# Vorlage fuer settings.toml auf dem Board (CIRCUITPY). Nur TAGGED_BOX_ID unterscheidet sich je Box.
CIRCUITPY_WIFI_SSID = "WLAN-Name"
CIRCUITPY_WIFI_PASSWORD = "WLAN-Passwort"
TAGGED_BOARD = "s2mini"   # oder "c6"
TAGGED_BOX_ID = 1
TAGGED_SERVER = "fangulus.kidslab.de"   # zum Testen auch "192.168.178.13:8090"
TAGGED_TOKEN = "wie TAGGED_TOKEN auf dem Server"
